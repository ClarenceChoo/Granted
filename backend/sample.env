# Sample Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# Firebase Configuration
# ============================================================================

# Firebase Web API Key
# Get from: Firebase Console > Project Settings > General > Web API Key
WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# ============================================================================
# OpenAI Configuration
# ============================================================================

# OpenAI API Key for grant matching
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ============================================================================
# Production Deployment Notes
# ============================================================================

# In production, these secrets are managed via Firebase Secret Manager:
# 
# Set secrets using:
#   firebase functions:secrets:set WEB_API_KEY
#   firebase functions:secrets:set OPENAI_API_KEY
#
# View secrets:
#   firebase functions:secrets:access WEB_API_KEY
#
# List all secrets:
#   gcloud secrets list --project=your-project-id
#
# Functions using secrets must declare them in decorators:
#   @https_fn.on_request(secrets=["OPENAI_API_KEY"])
